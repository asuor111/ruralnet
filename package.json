{
  "name": "ruralnet",
  "version": "0.1.0",
  "private": true,
  "description": "Rural connectivity intelligence for Nigerian communities and LGAs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "import:population": "tsx scripts/import-population.ts",
    "import:boundaries": "tsx scripts/import-boundaries.ts",
    "import:fibre": "tsx scripts/import-fibre.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}