# ------------------------------------------------------------------
# RuralNet configuration
# ------------------------------------------------------------------

# Runtime data mode:
#   mock  -> development only. All providers return clearly-labelled
#            MOCK data. No external network calls are made.
#   live  -> real public providers (Nominatim, World Bank, Overpass).
#            Any dataset that cannot be reached is reported as
#            "Data unavailable" - never invented.
RURALNET_MODE=mock

# PostgreSQL connection string.
# Optional in mock mode: when unset, research still works but results
# are not persisted between requests (an in-memory TTL cache is used).
# Example (docker compose up -d):
#   postgresql://ruralnet:ruralnet@localhost:5432/ruralnet?schema=public
DATABASE_URL=

# Nominatim (OpenStreetMap geocoder). Free public service; OSM's usage
# policy asks a valid User-Agent that identifies the application.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=research@example.com

# Overpass API (OpenStreetMap features). First reachable endpoint wins.
OVERPASS_ENDPOINTS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter

# Research tuning
FACILITIES_RADIUS_KM=10
FIBRE_SEARCH_RADIUS_KM=25
RESEARCH_CACHE_TTL_SECONDS=86400